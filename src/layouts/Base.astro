---
import { getImage } from 'astro:assets';
import { site, hero } from '../data/site.js';
import '../styles/global.css';
const {title = site.name, description = site.description} = Astro.props;
const tel = site.phone.replace(/[^0-9+]/g,'');
const smsBody = encodeURIComponent('[남부스카이차 문의]\n작업 주소:\n작업 내용:\n예상 높이:\n희망 날짜:');
// '?&body=' 형식이 안드로이드·아이폰 모두에서 동작
const sms = `sms:${tel}?&body=${smsBody}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({src: hero, width: 1200, format: 'jpeg'});
const ogImage = new URL(og.src, Astro.site).href;
const path = Astro.url.pathname;
const nav = [['/', '홈'], ['/about/', '업체소개'], ['/services/', '작업안내'], ['/projects/', '작업사례'], ['/contact/', '문의']];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  image: ogImage,
  taxID: site.bizNo,
  areaServed: site.areas.map(name => ({'@type': 'City', name})),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '06:00', closes: '23:00',
  },
};
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta name="theme-color" content="#0f2147"/>
<meta name="naver-site-verification" content="d864701f5d3dd33946fe08483b0d8d01ef670c66"/>
<meta name="google-site-verification" content="ncHWWUaxSDrGCJBvCNRH_yPDlcNx3jO0kpVVdgyXkJg"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:locale" content="ko_KR"/>
<link rel="sitemap" href="/sitemap.xml"/>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head><body>
<header class="header"><nav class="container nav"><a href="/" class="brand"><span>남부</span> 스카이차</a><div class="links">{nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</div><a class="header-tel" href={`tel:${tel}`}>☎ {site.phone}</a></nav></header>
<main><slot /></main>
<section class="banner"><div class="container"><h2>스카이차 작업, 편하게 문의하세요.</h2><p>{site.region} · 작업 가능 여부는 문의 바랍니다.</p><div class="actions"><a class="btn" href={`tel:${tel}`}>☎ {site.phone}</a><a class="btn secondary" href={sms}>문자 문의</a></div></div></section>
<footer class="footer"><div class="container"><strong>{site.name}</strong><p>{site.vehicle} · 최대 작업 높이 {site.maxHeight} · 바스켓 하중 {site.basketLoad}</p><p>전화 {site.phone} · 작업시간 {site.hours} · 대표 {site.owner} · 사업자등록번호 {site.bizNo}</p><p>{site.region}</p></div></footer>
<div class="callbar"><a class="call" href={`tel:${tel}`}>☎ 전화 문의</a><a class="text" href={sms}>💬 문자 문의</a></div>
</body></html>
