---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {site, hero} from '../data/site.js';
---
<Base title="업체 소개 | 남부스카이차 파주·고양·일산 스카이차"><section class="section"><div class="container"><h1>남부스카이차 소개</h1><p class="muted">파주·고양·일산을 중심으로 3.5톤 스카이차 고소작업을 상담합니다. 그 외 지역도 협의 가능합니다.</p><Image class="about-photo" src={hero} alt="남부스카이차 차량" width={1200} format="webp" quality={78} /><div class="cards"><article class="card"><h3>보유 장비</h3><p>{site.vehicle}</p></article><article class="card"><h3>최대 작업 높이</h3><p>{site.maxHeight} (문의 가능)</p></article><article class="card"><h3>바스켓 하중</h3><p>{site.basketLoad}</p></article><article class="card"><h3>주요 활동 지역</h3><p>{site.region}</p></article></div><p class="muted" style="margin-top:24px">영업시간 {site.hours} · 사업자등록번호 {site.bizNo}</p></div></section></Base>
