---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {site, hero, card} from '../data/site.js';
---
<Base title="업체 소개 | 남부스카이차 서울·경기 스카이차 24시 항시 대기"><section class="section"><div class="container"><h1>남부스카이차 소개</h1><p class="muted">파주, 일산, 의정부, 인천 등 서울 및 경기 전 지역에서 스카이차 고소작업을 상담합니다. {site.works}. {site.hours}합니다.</p><Image class="about-photo" src={hero} alt="남부스카이차 차량" width={1200} format="webp" quality={78} /><div class="cards"><article class="card"><h3>보유 장비</h3><p>{site.vehicle}</p></article><article class="card"><h3>작업시간</h3><p>{site.hours}</p><dl class="schedule">{site.schedule.map(s => <><dt>{s.label}</dt><dd>{s.times.map(t => <span>{t}</span>)}</dd></>)}</dl></article><article class="card"><h3>주요 활동 지역</h3><p>{site.region}</p></article></div><div class="owner"><Image class="biz-card" src={card} alt={`남부스카이차 명함 - ${site.owner} ${site.phone}`} width={529} format="webp" quality={90} /><p class="muted">대표 {site.owner} · 작업시간 {site.hours} · 사업자등록번호 {site.bizNo}</p></div></div></section></Base>
