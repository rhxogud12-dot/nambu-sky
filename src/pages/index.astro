---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { site, services, projects, heroTruck } from '../data/site.js';
---
<Base title="파주·일산·의정부·인천 스카이차 | 남부스카이차 24시 항시 대기">
<section class="hero"><div class="container"><div class="hero-text"><div class="eyebrow">파주 · 일산 · 의정부 · 인천 등 서울·경기 전 지역 / 24시 항시 대기</div><h1 class="sr-only">파주·일산·의정부·인천 스카이차 남부스카이차</h1><Image class="hero-truck" src={heroTruck} alt="남부스카이차 스카이차 차량" width={736} format="webp" quality={88} loading="eager" fetchpriority="high" /><p><strong class="works">{site.works}</strong><br/>스카이차 {site.vehicle}<br/>작업 가능 여부는 전화로 편하게 문의해 주세요.</p></div></div></section>
<section class="section"><div class="container"><h2>주요 작업 안내</h2><p class="muted">{site.works}. 작업 가능 여부는 현장 접근 조건과 장비 제원을 확인한 후 안내합니다.</p><div class="cards">{services.map(s=><article class="card"><h3>{s.title}</h3><p class="muted">{s.desc}</p></article>)}</div></div></section>
<section class="section alt"><div class="container"><h2>실제 작업 사례</h2><p class="muted">남부스카이차가 직접 작업한 현장 사진입니다. 사진을 누르면 크게 볼 수 있습니다.</p><Gallery items={projects.slice(0, 6)} /><div class="actions"><a class="btn outline" href="/projects/">작업 사례 전체 보기</a></div></div></section>
<section class="section"><div class="container"><h2>작업 지역</h2><p class="muted">파주스카이차·일산스카이차·의정부스카이차·인천스카이차 등 서울 및 경기 전 지역에서 작업합니다.</p><span class="pill">파주</span><span class="pill">일산</span><span class="pill">의정부</span><span class="pill">인천</span><span class="pill">서울·경기 전 지역</span><div class="specs"><div><b>24시</b><span>항시 대기</span></div><div><b>1톤 ~ 5톤</b><span>54M ~ 75M 등 다량 보유</span></div><div><b>서울·경기</b><span>전 지역 작업</span></div></div></div></section>
</Base>
