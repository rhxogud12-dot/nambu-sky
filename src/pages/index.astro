---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { site, services, projects, hero } from '../data/site.js';
const tel = site.phone.replace(/[^0-9+]/g,'');
---
<Base title="파주·고양·일산 스카이차 | 남부스카이차 3.5톤 최대 30m">
<section class="hero"><Image class="hero-bg" src={hero} alt="남부스카이차 3.5톤 스카이차 차량" width={1600} format="webp" quality={80} loading="eager" fetchpriority="high" /><div class="container"><div class="eyebrow">파주 · 고양 · 일산 중심 / 그 외 전 지역 협의</div><h1>높은 곳의 작업,<br/>남부스카이차와 상담하세요.</h1><p>{site.vehicle} · 최대 작업 높이 {site.maxHeight} · 바스켓 하중 {site.basketLoad}<br/>작업 가능 여부는 전화로 편하게 문의해 주세요.</p><div class="actions"><a class="btn" href={`tel:${tel}`}>☎ {site.phone}</a><a class="btn secondary" href="/projects/">작업 사례 보기</a></div></div></section>
<section class="section"><div class="container"><h2>주요 작업 안내</h2><p class="muted">작업 가능 여부는 현장 접근 조건과 장비 제원을 확인한 후 안내합니다.</p><div class="cards">{services.map(s=><article class="card"><h3>{s.title}</h3><p class="muted">{s.desc}</p></article>)}</div></div></section>
<section class="section alt"><div class="container"><h2>실제 작업 사례</h2><p class="muted">남부스카이차가 직접 작업한 현장 사진입니다. 사진을 누르면 크게 볼 수 있습니다.</p><Gallery items={projects.slice(0, 6)} /><div class="actions"><a class="btn outline" href="/projects/">작업 사례 전체 보기</a></div></div></section>
<section class="section"><div class="container"><h2>작업 지역</h2><p class="muted">파주스카이차·고양스카이차·일산스카이차 작업을 중심으로 상담하며, 그 외 지역도 일정과 현장 조건에 따라 협의합니다.</p><span class="pill">파주</span><span class="pill">고양</span><span class="pill">일산</span><span class="pill">그 외 전 지역 협의</span><div class="specs"><div><b>{site.maxHeight}</b><span>최대 작업 높이</span></div><div><b>{site.basketLoad}</b><span>바스켓 하중</span></div><div><b>{site.hours}</b><span>영업시간</span></div></div></div></section>
</Base>
