---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {site, card} from '../data/site.js';
const tel=site.phone.replace(/[^0-9+]/g,'');
const sms=`sms:${tel}?&body=${encodeURIComponent('[남부스카이차 문의]\n작업 주소:\n작업 내용:\n예상 높이:\n희망 날짜:')}`;
---
<Base title="작업 문의 | 남부스카이차 010-5322-3678"><section class="section"><div class="container"><h1>작업 문의</h1><Image class="biz-card" src={card} alt={`남부스카이차 명함 - ${site.owner} ${site.phone}, ${site.works}`} width={529} format="webp" quality={90} loading="eager" /><p class="muted">작업 주소, 작업 내용, 예상 높이, 희망 일정, 현장 사진을 준비해 주시면 상담에 도움이 됩니다. 현장 사진은 문자로 보내주세요.</p><div class="actions"><a class="btn" href={`tel:${tel}`}>☎ {site.phone}</a><a class="btn outline" href={sms}>💬 문자 문의</a></div><table class="spec-table" style="margin-top:40px"><tbody><tr><th>전화</th><td><a href={`tel:${tel}`}>{site.phone}</a></td></tr><tr><th>작업 분야</th><td>{site.works}</td></tr><tr><th>작업시간</th><td>{site.hours}</td></tr><tr><th>활동 지역</th><td>{site.region}</td></tr><tr><th>상호</th><td>{site.name}</td></tr><tr><th>대표</th><td>{site.owner}</td></tr><tr><th>사업자등록번호</th><td>{site.bizNo}</td></tr></tbody></table></div></section></Base>
