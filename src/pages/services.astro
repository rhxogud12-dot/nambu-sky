---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {site, fleet} from '../data/site.js';
---
<Base title="보유 장비 | 남부스카이차 1톤~19.5톤·굴절 스카이차" description="남부스카이차 보유 장비: 1톤(17~20m), 2.5톤(21~24m), 3.5톤(28~32m), 5톤(45m), 19.5톤(75m), 굴절 스카이차. 서울·경기 전 지역 24시 항시 대기."><section class="section"><div class="container"><h1>보유 장비</h1><div class="fleet">{fleet.map(f=><figure><Image src={f.img} alt={f.name} width={560} format="webp" quality={85} loading="lazy" /><figcaption><strong>{f.name}</strong>{f.height && <span>작업 높이 {f.height}</span>}</figcaption></figure>)}</div><table class="spec-table" style="margin-top:30px"><tbody><tr><th>작업시간</th><td><p class="hours">{site.hours}</p><dl class="schedule">{site.schedule.map(s => <><dt>{s.label}</dt><dd>{s.times.map(t => <span>{t}</span>)}</dd></>)}</dl></td></tr><tr><th>활동 지역</th><td>{site.region}</td></tr></tbody></table></div></section></Base>
