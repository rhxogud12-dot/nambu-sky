---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {site, services, fleet} from '../data/site.js';
---
<Base title="작업 안내 | 남부스카이차 1톤~19.5톤·굴절 스카이차 보유" description="남부스카이차 보유 장비: 1톤(17~20m), 2.5톤(21~24m), 3.5톤(28~32m), 5톤(45m), 19.5톤(75m), 굴절 스카이차. 서울·경기 전 지역 24시 항시 대기."><section class="section"><div class="container"><h1>작업 안내</h1><p class="muted">현장 여건과 작업 높이 등을 확인하여 가능 여부를 상담합니다. 작업 가능 여부는 문의 바랍니다.</p><div class="cards">{services.map(s=><article class="card"><h3>{s.title}</h3><p class="muted">{s.desc}</p></article>)}</div><h2 style="margin-top:50px">보유 장비</h2><div class="fleet">{fleet.map(f=><figure><Image src={f.img} alt={f.name} width={560} format="webp" quality={85} loading="lazy" /><figcaption><strong>{f.name}</strong>{f.height && <span>작업 높이 {f.height}</span>}</figcaption></figure>)}</div><table class="spec-table" style="margin-top:30px"><tbody><tr><th>작업시간</th><td>{site.hours}</td></tr><tr><th>활동 지역</th><td>{site.region}</td></tr></tbody></table></div></section></Base>
